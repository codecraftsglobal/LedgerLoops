<!DOCTYPE html>
<html lang="en" dir="ltr">
	<head>
		<script src="%PUBLIC_URL%/env-config.js"></script>
		<link rel="icon" type="image/svg+xml" href="%PUBLIC_URL%/ledgerloop-mark.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f6f8f7" />
		<meta name="description" content="LedgerLoop is accounting software for businesses to manage invoicing, expenses, payroll, inventory, taxes, and financial reporting." />
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		<meta property="og:image" content="%PUBLIC_URL%/ledgerloop-mark.svg">
		<link rel="apple-touch-icon" href="%PUBLIC_URL%/ledgerloop-mark.svg" />

		<link rel="manifest" href="%PUBLIC_URL%/manifest.json" />
		<link
			rel="stylesheet"
			href="https://use.fontawesome.com/releases/v5.6.3/css/all.css"
